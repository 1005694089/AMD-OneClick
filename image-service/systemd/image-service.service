[Unit]
Description=AMD OneClick image-service daemon (multi-verb: build/pull/acr_backup/distribute/evict)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated low-privilege user. NOT in the host `docker` group (which would be
# root-equivalent); use rootless docker/podman or nerdctl against containerd. See setup.sh.
# NOTE: setup.sh rewrites these two lines to the operator's AGENT_USER at install time;
# 'imagesvc' is only the default. Edit AGENT_USER (or these lines) — not just one.
User=imagesvc
Group=imagesvc

# --- Rootless nerdctl client environment ---
# The daemon is a pure nerdctl CLIENT. Rootless containerd + buildkit run as imagesvc
# `systemctl --user` services (enabled via `loginctl enable-linger imagesvc`), OUTSIDE this
# hardened unit, where they perform the setuid uid-mapping (newuidmap/newgidmap) and netns
# (rootlesskit/slirp4netns) at startup. This unit only opens the already-running rootless unix
# sockets, so it performs NO privilege escalation — which is why NoNewPrivileges/RestrictSUIDSGID
# below can all stay on. Without these vars nerdctl would default to the ROOT/system containerd
# socket (the 'no new privileges' / permission failure that was observed).
# %U expands to this unit's numeric UID (imagesvc) — no hard-coded uid. NOTE: ProtectHome (any
# mode) masks /home, /root AND /run/user, so the rootless sockets under /run/user/%U would be
# hidden; BindPaths=/run/user/%U below is applied AFTER ProtectHome to re-expose ONLY the runtime
# dir. XDG_DATA_HOME/XDG_CONFIG_HOME are relocated onto /disk/ssd2 (covered by ReadWritePaths).
# NOTE: setup.sh also writes these into the EnvironmentFile with the resolved uid; the values
# here are the in-unit defaults and must agree with that.
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=XDG_DATA_HOME=/disk/ssd2/imagesvc/.local/share
Environment=XDG_CONFIG_HOME=/disk/ssd2/imagesvc/.config
Environment=CONTAINERD_ADDRESS=/run/user/%U/containerd/containerd.sock
Environment=BUILDKIT_HOST=unix:///run/user/%U/buildkit/buildkitd.sock

EnvironmentFile=/etc/amd-oneclick-image-service.env
ExecStart=/usr/bin/python3 /opt/amd-oneclick/image-service/agent.py
Restart=always
RestartSec=5

# --- Hardening ---
# ProtectHome hides /home so a compromised daemon (or build escape) cannot read user
# kubeconfigs. The DISTRIB_SSH_KEY (root-on-every-node) therefore lives OUTSIDE $HOME under
# /disk/ssd2/.ssh and is exposed read-only via ReadOnlyPaths. ACR Enterprise credentials live
# outside $HOME via DOCKER_CONFIG (set in the EnvironmentFile, e.g. /etc/amd-oneclick/docker),
# exposed via ReadWritePaths. Build scratch, pulled layers and save tarballs land under /disk/ssd2.
# NOTE: setup.sh rewrites ReadWritePaths/ReadOnlyPaths to the operator's IMAGE_WORK_DIR and
# DISTRIB_SSH_KEY dir at install time; the paths below are only defaults. With ProtectSystem=strict
# the work dir MUST be listed in ReadWritePaths or the daemon cannot write builds/tarballs.
# NoNewPrivileges=true is PROVABLY safe for a rootless CLIENT: a nerdctl CLI talking to an
# already-running unix-socket containerd/buildkit performs no setuid, no newuidmap/newgidmap, and
# no namespace creation — all of that happened in the imagesvc user-session services before this
# unit ran. RestrictSUIDSGID=true likewise stays. PrivateTmp is fine because the rootless sockets
# live under /run/user, not /tmp.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=tmpfs (not =true): both hide real /home & /root, but bare ProtectHome ALSO masks
# /run/user, which would hide the rootless sockets this client must open. tmpfs lets BindPaths
# below punch /run/user/%U back through (BindPaths is processed after ProtectHome).
ProtectHome=tmpfs
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
# /disk/ssd2 holds XDG_DATA_HOME/XDG_CONFIG_HOME + build scratch/tarballs. setup.sh rewrites this
# line to the operator's DOCKER_CONFIG dir and IMAGE_WORK_DIR.
ReadWritePaths=/etc/amd-oneclick/docker /disk/ssd2
ReadOnlyPaths=/disk/ssd2/.ssh
# Re-expose ONLY the rootless runtime dir (containerd/buildkit sockets) through ProtectHome's mask.
# Must come AFTER ProtectHome to take effect. setup.sh rewrites %U to the resolved uid.
BindPaths=/run/user/%U

[Install]
WantedBy=multi-user.target
