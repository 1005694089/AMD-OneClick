# Docker build ignore file for Manager image

# Git
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info
.eggs

# Virtual environments
venv
.venv
env

# IDE
.idea
.vscode
*.swp
*.swo

# Logs
*.log

# Docker directory (large files, only needed for base/oneclick builds)
docker/models
docker/*.whl
# Re-include ROCm wheel needed for Dockerfile.rocm-all-in-one
!docker/paddlepaddle_dcu-*.whl

# K8s configs
*.yaml
# Re-include pipeline configs needed for Dockerfile.rocm-all-in-one
!docker/configs/*.yaml

# Notebooks
notebooks/*
!notebooks/ppocr_vl_demo.ipynb

# Documentation
*.md

